# Copy to .env.local for local development, or set in Vercel (Project › Settings › Environment Variables).
# Supabase and the analytics id are optional: without Supabase the site keeps admin changes in memory.
# ADMIN_PASSWORD is only for local development and is ignored in production, where sign-in is the e-mailed code. Locally, leaving it unset keeps admin open.

# Supabase project URL and service-role key (Project Settings › API). Server-side only; never expose the key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The public (anon or publishable) key, for sign-in by e-mailed code. Without all three the site offers only the shared password.
SUPABASE_ANON_KEY=

# Resend API key (sending access) for the invitation e-mail the site sends itself. Without it invitations still work, but the
# administrator passes the message on. Sign-in codes are sent by Supabase through the same Resend domain, not through this key.
RESEND_API_KEY=
# Sender of the invitation, if not «BOC <login@mail.jakobjolstad.com>» (the domain must be verified at Resend).
MAIL_FROM=

# Shared password for /admin until real sign-in replaces it.
ADMIN_PASSWORD=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Optional: without it there is no statistics and no cookie banner.
# With it, nothing is loaded and no cookie is set until a visitor says yes in the banner.
GA_MEASUREMENT_ID=
