# Copy to .env.local for local development, or set in Vercel (Project › Settings › Environment Variables).
# Supabase and the analytics id are optional: without Supabase the site keeps admin changes in memory.
# ADMIN_PASSWORD is required in production: without it admin is closed to everyone. Locally, leaving it unset keeps admin open.

# Supabase project URL and service-role key (Project Settings › API). Server-side only; never expose the key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for /admin until real sign-in replaces it.
ADMIN_PASSWORD=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Optional: without it there is no statistics and no cookie banner.
# With it, nothing is loaded and no cookie is set until a visitor says yes in the banner.
GA_MEASUREMENT_ID=
